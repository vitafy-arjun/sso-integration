VITE_GATEWAY_ORIGIN=http://localhost:3000
VITE_TENANT_ID=your-tenant-uuid
VITE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Optional legacy alias (must match VITE_TENANT_ID if set)
# VITE_CLIENT_ID=your-tenant-uuid

# Optional JWT audience for token verification (default: vitafy-integration-api)
# VITE_INTEGRATION_TOKEN_AUDIENCE=vitafy-integration-api

# Optional gateway requestapp header (default: vitafyhealth)
# VITE_REQUEST_APP=vitafyhealth

# OAuth redirect: {origin}/auth/vitafy/callback (must match tenant oauthRedirectUri)
